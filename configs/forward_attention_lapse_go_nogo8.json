{
  "runtime": {
    "project_name": "eegle",
    "session_root": "data",
    "runtime_cache_dir": ".runtime"
  },
  "telemetry": {
    "console_level": "default",
    "file_level": "realtime",
    "trace_enabled": false,
    "heartbeat_seconds": 5.0
  },
  "hardware": {
    "eeg": {
      "family": "Enobio",
      "profile": "enobio8_inhibition",
      "expected_channel_counts": [8],
      "expected_sample_rate_hz": 500,
      "lsl_stream_type": "EEG",
      "lsl_name_patterns": ["enobio", "nic", "neuroelectrics", "LSLOutletStreamName-EEG"],
      "allow_type_only_fallback": false,
      "stream_timeout_seconds": 5.0,
      "sample_probe_seconds": 2.0,
      "required_for_run": true
    },
    "markers": {
      "lsl_stream_name": "EEGleMarkers",
      "lsl_stream_type": "Markers",
      "required_for_realtime": true
    },
    "display": {
      "screen_index": 0,
      "full_screen": false,
      "win_type": "pyglet",
      "allow_gui": true,
      "size": [1000, 700],
      "units": "height",
      "background_color": "black",
      "photodiode_patch": false,
      "expected_refresh_rate_hz": 60.0,
      "fixed_display_latency_ms": 0.0
    }
  },
  "experiment": {
    "experiment_id": "attention_lapse_go_nogo8_observe_only",
    "participant_id": "example-participant",
    "task": "go_nogo",
    "mode": "forward",
    "components": {
      "preflight": "default",
      "task": "go_nogo",
      "eeg_recorder": "lsl_csv",
      "realtime_processor": "lsl",
      "feedback": "disabled",
      "analysis": "minimal"
    },
    "output_formats": ["csv", "jsonl", "triggers_txt", "raw_json"]
  },
  "processes": {
    "recorder": {
      "enabled": true,
      "backend": "lsl_csv",
      "csv_mirror": true,
      "startup_timeout_seconds": 8.0
    },
    "realtime_processor": {
      "enabled": true,
      "backend": "lsl",
      "preprocessor": "causal_bandpass_notch",
      "model": "causal_bandpower_logreg",
      "startup_timeout_seconds": 8.0
    },
    "feedback": {
      "enabled": false,
      "backend": "disabled"
    },
    "dashboard": {
      "enabled": true,
      "backend": "http",
      "host": "127.0.0.1",
      "port": 8765,
      "startup_timeout_seconds": 4.0
    },
    "offline_analyzer": {
      "enabled": true,
      "backend": "minimal",
      "timeout_seconds": 120.0
    }
  },
  "tasks": {
    "go_nogo": {
      "trials": 240,
      "go_probability": 0.7,
      "no_go_probability": 0.3,
      "stimulus_seconds": 0.8,
      "isi_seconds": 0.7,
      "practice_enabled": true,
      "practice_message_min_seconds": 1.0,
      "countdown_seconds": 3,
      "countdown_step_seconds": 1.0,
      "response_keys": ["space"],
      "escape_keys": ["escape"],
      "completion_auto_close_seconds": 30.0,
      "shapes": ["circle", "square", "triangle", "star", "hexagon"],
      "colors": ["red", "blue", "green", "yellow", "magenta"],
      "no_go": {
        "shape": "x",
        "color": "white",
        "randomize": false
      }
    }
  },
  "realtime": {
    "enabled": true,
    "max_chunk_samples": 32,
    "max_pull_samples": 128,
    "pull_timeout_seconds": 0.01,
    "clock_error_threshold_seconds": 60.0,
    "performance": {
      "primary_latency_budget_ms": 50,
      "writer_flush_every": 50,
      "writer_flush_interval_ms": 100,
      "inference_queue_max_epochs": 4,
      "skip_shadows_when_queue_depth_gte": 2,
      "large_cap_channel_threshold": 32
    },
    "inference": {
      "enabled": false
    },
    "classifier": {
      "enabled": true
    },
    "capture": {
      "enabled": true
    },
    "dashboard": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 8765,
      "demo": {
        "enabled": false,
        "prediction_delay_seconds": 1.2,
        "error_rate": 0.1,
        "seed": 42
      }
    },
    "epoching": {
      "enabled": true,
      "marker_prefix": "go_nogo_stimulus_onset",
      "tmin_seconds": -2.0,
      "tmax_seconds": 0.0,
      "timebase": "lsl",
      "sample_tolerance_seconds": 0.01,
      "drop_incomplete": true,
      "include_practice_trials": false,
      "data_source": "causal_preprocessed"
    },
    "preprocessing": {
      "notch_hz": 60.0,
      "bandpass_low_hz": 1.0,
      "bandpass_high_hz": 45.0,
      "downsample_factor": 1,
      "reference": "average"
    },
    "quality_gate": {
      "minimum_finite_fraction": 1.0,
      "minimum_channel_std_uv": 0.01,
      "max_abs_uv": 250.0,
      "max_peak_to_peak_uv": 400.0
    },
    "model": {
      "kind": "causal_bandpower_logreg",
      "family": "classical",
      "target": "attention_lapse_binary",
      "attention_lapse_label": "slow_go_rt",
      "slow_rt_quantile": 0.8,
      "prediction_horizon": "same_trial_response",
      "bundle_path": null,
      "artifact_path": null,
      "input_layout": "samples_x_channels",
      "input_units": "microvolts",
      "required_channels": ["Fz", "Cz", "Pz", "C3", "C4", "P3", "P4", "Oz"],
      "input_contract": {
        "input_layout": "samples_x_channels",
        "input_units": "microvolts",
        "channel_order": ["Fz", "Cz", "Pz", "C3", "C4", "P3", "P4", "Oz"],
        "required_channels": ["Fz", "Cz", "Pz", "C3", "C4", "P3", "P4", "Oz"],
        "optional_channels": [],
        "channel_groups": {
          "frontal": ["Fz"],
          "central": ["Cz", "C3", "C4"],
          "posterior": ["Pz", "P3", "P4", "Oz"]
        },
        "missing_channel_policy": "error",
        "resampling": "none",
        "tensor_layout": "batch_1_channels_samples"
      },
      "baseline_seconds": [-2.0, 0.0],
      "decision_probability": 0.5,
      "seed": 42
    },
    "shadow_models": [],
    "calibration": {
      "threshold_metric": "balanced_accuracy",
      "allow_multi_session": true,
      "support_trials": 50,
      "support_grid": [0, 20, 50, 100],
      "prototype_distance_metric": "cosine"
    },
    "adaptation": {
      "enabled": false,
      "update_primary": true,
      "update_shadows": false,
      "label_mode": "slow_go_rt",
      "slow_rt_quantile": 0.8,
      "min_correct_go_rts_for_threshold": 20,
      "warmup_trials": 20,
      "snapshot_every_updates": 10,
      "allowed_model_kinds": ["foundation_prototype", "causal_bandpower_logreg"],
      "strict_no_leakage": true,
      "threshold_metric": "balanced_accuracy",
      "min_examples_for_threshold_update": 4
    },
    "decision_policy": {
      "kind": "observe_only",
      "enabled": true,
      "allow_task_adaptation": false,
      "allow_stimulation": false,
      "research_safety_ack": false,
      "probability_threshold": 0.7,
      "refractory_seconds": 10.0,
      "actions": ["observe_only"]
    },
    "feedback": {
      "mode": "observe_only",
      "allow_task_adaptation": false,
      "allow_stimulation": false,
      "research_safety_ack": false,
      "client": {
        "enabled": false,
        "backend": "disabled"
      }
    },
    "alpha": {
      "enabled": false
    },
    "event_features": {
      "enabled": false
    }
  },
  "analysis": {
    "erp": {
      "enabled": false,
      "task": "go_nogo",
      "tmin_seconds": -2.0,
      "tmax_seconds": 0.0,
      "baseline_seconds": [-2.0, 0.0],
      "filter_low_hz": 0.1,
      "filter_high_hz": 30.0,
      "notch_hz": 60.0,
      "input_units": "microvolts",
      "roi_channels": ["Cz", "Pz", "P3", "P4"],
      "n2_roi_channels": ["Fz", "Cz"],
      "dashboard_montage_times_ms": [-2000, -1500, -1000, -500, 0],
      "dashboard_px_per_second": 220
    },
    "alpha": {
      "enabled": false
    },
    "html": {
      "enabled": true,
      "max_raw_points": 120000,
      "max_alpha_points": 12000
    },
    "reports": {
      "behavior": true,
      "raw_eeg_summary": true,
      "classification": true
    }
  }
}
